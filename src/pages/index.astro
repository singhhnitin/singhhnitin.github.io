---
export const prerender = true;
import { getCollection } from "astro:content";
import DefaultPageLayout from "$/layouts/default.astro";
import PostPreviewList from "$/components/PostPreviewList.astro";
const title = "Home";
const description = "GSoC 2026 contributor at DBpedia Hindi Chapter";

const allPosts = await getCollection("blog");
const sortedPosts = allPosts.sort(
  (a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);

const featuredPost = allPosts.find((post) => post.slug === "pipeline-diagrams");
const restPosts = sortedPosts.filter((post) => post.slug !== "pipeline-diagrams");
---
<DefaultPageLayout content={{ title, description }} showPageHeader={false}>
  <h1>Hindi DBpedia Chapter</h1>
  <p>
    This page is dedicated to providing weekly updates on the project.
  </p>
  <p>
    Read the blog posts or check <a href="/about">About</a> for more info.
  </p>
  <p>
    Social Links:
    <a href="https://github.com/singhhnitin">GitHub</a>
    <a href="mailto:nitinsingh3323@gmail.com">Email</a>
  </p>
  <hr />
  {featuredPost && <PostPreviewList posts={[featuredPost]} heading="Featured" />}
  <hr />
  <PostPreviewList posts={restPosts} heading="Recent Posts" />
</DefaultPageLayout>
